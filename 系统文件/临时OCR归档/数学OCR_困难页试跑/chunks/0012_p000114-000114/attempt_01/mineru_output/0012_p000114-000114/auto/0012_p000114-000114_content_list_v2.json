                827
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\rightarrow \\begin{bmatrix} 1 & 1 & \\lambda & \\vdots & - 2 \\\\ 0 & \\lambda - 1 & 1 - \\lambda & \\vdots & 0 \\\\ 0 & 0 & (\\lambda + 2)(\\lambda - 1) \\vdots & 3(1 - \\lambda) \\end{bmatrix}.",
                "math_type": "latex",
                "image_source": {
                    "path": "images/37b9d2b8c559e6a21efe7f39bfb2eb64f81323885b68c5ea76aa000f3be1029b.jpg"
