        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "得同解方程组"
                    }
                ]
            },
            "bbox": [
                198,
                79,
                321,
                97
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{aligned}\\left\\{ \\begin{aligned}x_{1} + 2x_{3} + 12x_{5} &= 10, \\\\x_{2} - x_{3} \\quad - 8x_{5} &= - 6, \\\\x_{4} - 3x_{5} &= - 2.\\end{aligned} \\right.\\end{aligned}\\tag{*}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/0b2f882c30bef9d1570076356ab4ccbce01286d9ae00b03e91bcb44fe99df730.jpg"
                }
            },
            "bbox": [
                315,
                102,
                563,
                167
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "令 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x_{3} = 0 , x_{5} = 0"
                    },
                    {
                        "type": "text",
                        "content": ",得方程组 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "Ax = \\boldsymbol{b}"
                    },
                    {
                        "type": "text",
                        "content": "的一个特解"
                    }
                ]
            },
            "bbox": [
                198,
                172,
                600,
                190
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\boldsymbol{\\alpha} = (10, -6, 0, -2, 0)^{\\mathrm{T}},",
                "math_type": "latex",
                "image_source": {
                    "path": "images/12fb42c6326d6c13d495e5fe047b7cc6beb018faaff47b771f9c326af055bdf8.jpg"
                }
            },
            "bbox": [
                326,
                196,
                551,
                214
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "对应的齐次方程组为"
                    }
                ]
            },
            "bbox": [
                198,
                219,
                378,
                236
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\left\\{ \\begin{aligned} x_{1} + 2x_{3} + 12x_{5} &= 0, \\\\ x_{2} - x_{3} &= 8x_{5} = 0, \\\\ x_{4} - 3x_{5} &= 0, \\end{aligned} \\right.",
                "math_type": "latex",
                "image_source": {
                    "path": "images/f136d2905f1df2e7a77c48ac04e46276c871cbbc1aa202e32d9919aded21aee1.jpg"
                }
            },
            "bbox": [
                329,
                242,
                549,
                307
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "得 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "Ax = \\mathbf{0}"
                    },
                    {
                        "type": "text",
                        "content": "的同解方程组"
                    }
                ]
            },
            "bbox": [
                161,
                312,
                371,
                329
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{cases}x_{1} = - 2x_{3} - 12x_{5}, \\\\x_{2} = \\quad x_{3} + 8x_{5}, \\\\x_{4} = \\quad 3x_{5},\\end{cases}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/61796cdd94a00cf7d8ec4510c1e243beacd5d9b56edfd36ce1282f9fe65a6723.jpg"
                }
            },
            "bbox": [
                352,
                336,
                526,
                400
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "分别令 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x_{3} = 1 , x_{5} = 0"
                    },
                    {
                        "type": "text",
                        "content": "和 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x_{3} = 0 , x_{5} = 1"
                    },
                    {
                        "type": "text",
                        "content": ",得 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "Ax = \\mathbf{0}"
                    },
                    {
                        "type": "text",
                        "content": "的基础解系"
                    }
                ]
            },
            "bbox": [
                159,
                406,
                692,
                424
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\eta_{1} = (-2,1,1,0,0)^{\\mathrm{T}}, \\eta_{2} = (-12,8,0,3,1)^{\\mathrm{T}}.",
                "math_type": "latex",
                "image_source": {
                    "path": "images/f06ffba49cf91e2fd96460cf014b7b5cd0abc505c94697c607acb9fa23734bf6.jpg"
                }
            },
            "bbox": [
                242,
                430,
                625,
                448
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "所以方程组的通解为："
                    }
                ]
            },
            "bbox": [
                159,
                453,
                349,
                470
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "(10,-6,0,-2,0)^{\\mathrm{T}} + k_{1}(-2,1,1,0,0)^{\\mathrm{T}} + k_{2}(-12,8,0,3,1)^{\\mathrm{T}}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/a6014d38064ddcaf1fa4b4dbeba145d17950c0845a06503defffb37cf0f16b0c.jpg"
                }
            },
            "bbox": [
                200,
                475,
                710,
                493
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "equation_inline",
                        "content": "k_{1},k_{2}"
                    },
                    {
                        "type": "text",
                        "content": "为任意常数."
                    }
                ]
            },
            "bbox": [
                159,
                499,
                317,
                517
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "或对同解方程组(*)，令 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x_{3} = t, x_{5} = u"
                    },
                    {
                        "type": "text",
                        "content": ",解出"
                    }
                ]
            },
            "bbox": [
                198,
                524,
                574,
                541
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{cases}x_{1} = 10 - 2t - 12u, \\\\x_{2} = -6 + t + 8u, \\\\x_{3} = t, \\\\x_{4} = -2 + 3u, \\\\x_{5} = u.\\end{cases}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/0419b08efe2285e9316dcbb02d09326986644080ea2e6d84cdf9cb6aa0660b4f.jpg"
                }
            },
            "bbox": [
                347,
                545,
                529,
                658
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "亦得通解 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x = ( 1 0 , - 6 , 0 , - 2 , 0 ) ^ { \\mathrm { T } } + t ( - 2 , 1 , 1 , 0 , 0 ) ^ { \\mathrm { T } } + u ( - 1 2 , 8 , 0 ,"
                    },
                    {
                        "type": "equation_inline",
                        "content": "3,1)^{\\mathrm{T}},t,u"
                    },
                    {
                        "type": "text",
                        "content": "为任意常数."
                    }
                ]
            },
            "bbox": [
                159,
                664,
                715,
                705
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "例9【解】对增广矩阵作初等行变换，有"
                    }
                ]
            },
            "bbox": [
                200,
                734,
                571,
                755
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\overline{\\boldsymbol{A}} = \\begin{bmatrix} \\lambda & 1 & 1 \\vdots \\lambda - 3 \\\\ 1 & \\lambda & 1 \\vdots - 2 \\\\ 1 & 1 & \\lambda \\vdots - 2 \\end{bmatrix} \\rightarrow \\begin{bmatrix} 1 & 1 & \\lambda \\vdots - 2 \\\\ 1 & \\lambda & 1 \\vdots - 2 \\\\ \\lambda & 1 & 1 \\vdots \\lambda - 3 \\end{bmatrix}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/3fc6bf5579d662a8741682099bfcf05ea92c00a86d903b020e06406e0fea9754.jpg"
                }
            },
            "bbox": [
                196,
                762,
