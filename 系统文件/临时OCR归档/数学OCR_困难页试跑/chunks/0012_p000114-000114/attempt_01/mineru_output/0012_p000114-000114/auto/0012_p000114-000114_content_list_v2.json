                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "当 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\lambda = - 2"
                    },
                    {
                        "type": "text",
                        "content": "时 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "r(\\boldsymbol{A}) = 2, r(\\overline{\\boldsymbol{A}}) = 3"
                    },
                    {
                        "type": "text",
