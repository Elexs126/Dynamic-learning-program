                    {
                        "type": "text",
                        "content": "如由 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "A \\xrightarrow{ 行 } B"
                    },
                    {
                        "type": "text",
                        "content": ",即 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "P_{1} \\cdots P_{2} P_{1} A = B."
                    },
                    {
                        "type": "text",
                        "content": "记 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "P = P_{1} \\cdots P_{2}P_{1}"
                    },
                    {
                        "type": "text",
                        "content": "有 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "PA = B,"
                    },
                    {
                        "type": "equation_inline",
                        "content": "P_{1} \\cdots P_{2} P_{1} A = B"
                    },
                    {
                        "type": "text",
                        "content": "和 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "P_{1} \\cdots P_{2} P_{1} E = P"
                    },
                    {
                        "type": "text",
                        "content": "表明当A經行变换得到B时，E在同样的行变换下得到P，即 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(A \\mid E) \\to (B \\mid P)"
                    }
                ]
            },
