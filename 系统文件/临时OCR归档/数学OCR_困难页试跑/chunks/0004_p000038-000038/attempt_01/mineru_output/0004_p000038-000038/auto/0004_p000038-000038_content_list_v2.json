        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "称为一个 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "m \\times n"
                    },
                    {
                        "type": "text",
                        "content": "矩阵，当 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "m = n"
                    },
                    {
                        "type": "text",
                        "content": "时，矩阵A称为n阶矩阵或叫n阶方阵."
                    }
                ]
            },
            "bbox": [
                92,
                180,
