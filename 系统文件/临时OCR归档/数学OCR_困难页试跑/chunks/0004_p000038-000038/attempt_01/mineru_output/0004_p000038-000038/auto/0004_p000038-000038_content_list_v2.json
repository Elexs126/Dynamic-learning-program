                198
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "如果一个矩阵的所有元素都是0，即"
                    }
                ]
            },
            "bbox": [
                132,
                204,
                443,
                221
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{bmatrix} 0 & 0 & \\cdots & 0 \\\\ 0 & 0 & \\cdots & 0 \\\\ \\vdots & \\vdots & & \\vdots \\\\ 0 & 0 & \\cdots & 0 \\end{bmatrix},",
                "math_type": "latex",
                "image_source": {
                    "path": "images/fccc5bcbb23c56bc823f2cfa66d0e6145e26c0a22613fd693d319a18566feddf.jpg"
