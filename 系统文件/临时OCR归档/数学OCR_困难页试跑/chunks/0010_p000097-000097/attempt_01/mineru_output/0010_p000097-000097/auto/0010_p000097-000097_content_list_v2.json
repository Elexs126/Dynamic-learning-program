        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\boldsymbol { \\alpha } _ { 1 } = c _ { 1 1 } \\boldsymbol { \\beta } _ { 1 } + c _ { 2 1 } \\boldsymbol { \\beta } _ { 2 } + \\cdots + c _ { t 1 } \\boldsymbol { \\beta } _ { t } ,",
