        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\left\\{ \\begin{aligned} \\left( \\boldsymbol{\\alpha}, \\boldsymbol{\\alpha}_{1} \\right) &= x_{1} + 3x_{2} + 2x_{3} = 0, \\\\ \\left( \\boldsymbol{\\alpha}, \\boldsymbol{\\alpha}_{2} \\right) &= x_{1} + x_{2} - 2x_{3} = 0, \\end{aligned} \\right.",
                "math_type": "latex",
                "image_source": {
