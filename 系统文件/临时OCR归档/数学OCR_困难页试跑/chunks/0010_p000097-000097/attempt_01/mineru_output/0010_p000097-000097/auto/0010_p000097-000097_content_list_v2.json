        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{aligned}\\left( \\boldsymbol { \\alpha } _ { 1 } , \\boldsymbol { \\alpha } _ { 2 } , \\cdots , \\boldsymbol { \\alpha } _ { s } \\right) &= \\left( \\boldsymbol { \\beta } _ { 1 } , \\boldsymbol { \\beta } _ { 2 } , \\cdots , \\boldsymbol { \\beta } _ { t } \\right) \\boldsymbol { C } , \\\\r \\left( \\boldsymbol { \\alpha } _ { 1 } , \\boldsymbol { \\alpha } _ { 2 } , \\cdots , \\boldsymbol { \\alpha } _ { s } \\right) &= r \\left[ \\left( \\boldsymbol { \\beta } _ { 1 } , \\boldsymbol { \\beta } _ { 2 } , \\cdots , \\boldsymbol { \\beta } _ { t } \\right) \\boldsymbol { C } \\right] \\\\& \\leqslant r \\left( \\boldsymbol { \\beta } _ { 1 } , \\boldsymbol { \\beta } _ { 2 } , \\cdots , \\boldsymbol { \\beta } _ { t } \\right) ,\\end{aligned}",
