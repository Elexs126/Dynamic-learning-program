        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "正定的充分必要条件是顺序主子式全大于0，故"
                    }
                ]
            },
            "bbox": [
                178,
                80,
                552,
                98
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\left\\{ \\begin{aligned} 4 - t ^ { 2 } = ( 2 - t ) ( 2 + t ) > 0 , \\quad t \\in ( - 2 , 2 ) , \\\\ - 4 t ^ { 2 } - 4 t + 8 = - 4 ( t - 1 ) ( t + 2 ) > 0 , \\quad t \\in ( - 2 , 1 ) , \\end{aligned} \\right.",
                "math_type": "latex",
                "image_source": {
                    "path": "images/ef94aca84b896bb9b9a4685660a831ebf9a5db7648bb78100dc6a38e069e6bc6.jpg"
                }
            },
            "bbox": [
                210,
                104,
                677,
                151
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "故 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "t \\in (-2,1)"
                    },
                    {
                        "type": "text",
                        "content": "时，二次型f正定."
                    }
                ]
            },
            "bbox": [
                176,
                156,
                452,
                174
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "例16【分析】A正定⇔A的特征值 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\lambda > 0."
                    }
                ]
            },
            "bbox": [
                211,
                209,
                579,
                230
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{aligned}\\left| \\lambda \\boldsymbol{E} - \\boldsymbol{A} \\right| &=\\left| \\begin{matrix}\\lambda & -1 & -1 \\\\-1 & \\lambda - 2 & -1 \\\\-1 & -1 & \\lambda\\end{matrix} \\right|= \\left| \\begin{matrix}\\lambda + 1 & 0 & -\\lambda - 1 \\\\-1 & \\lambda - 2 & -1 \\\\-1 & -1 & \\lambda\\end{matrix} \\right| \\\\&= \\lambda (\\lambda + 1) (\\lambda - 3)  .\\end{aligned}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/708d0f9a4dd33d3ade97ca4726802c3ffcfc5cc45e69da2d37a1e323131fb8de.jpg"
                }
            },
            "bbox": [
                210,
                237,
                697,
                331
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "A 的特征值为 "
                    },
                    {
                        "type": "equation_inline",
                        "content": ";0,-1,3"
                    }
                ]
            },
            "bbox": [
                208,
                340,
                410,
                356
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "A+E的特征值为 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "k,k-1,k+3."
                    }
                ]
            },
            "bbox": [
                208,
                365,
                495,
                381
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "equation_inline",
                        "content": "\\boldsymbol{A} + k\\boldsymbol{E}"
                    },
                    {
                        "type": "text",
                        "content": "正定 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\Leftrightarrow \\begin{cases} k > 0   , \\\\ k - 1 > 0   , \\\\ k + 3 > 0 \\end{cases} \\Leftrightarrow     k > 1."
                    }
                ]
            },
            "bbox": [
                210,
                390,
                542,
                456
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "例17【证】因A正定 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\Rightarrow A^{\\mathrm{T}} = A, A"
                    },
                    {
                        "type": "text",
                        "content": "可逆且 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\mid \\boldsymbol{A} \\mid > 0."
                    }
                ]
            },
            "bbox": [
                211,
                491,
                667,
                512
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "由 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\left( \\boldsymbol{A}^{*} \\right)^{\\mathrm{T}} = \\left( \\boldsymbol{A}^{\\mathrm{T}} \\right)^{*} = \\boldsymbol{A}^{*} \\Rightarrow \\boldsymbol{A}^{*}"
                    },
                    {
                        "type": "text",
                        "content": "是对称矩阵."
                    }
                ]
            },
            "bbox": [
                211,
                520,
                564,
                538
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "方法一用定义.因A可逆,故 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x = A y"
                    },
                    {
                        "type": "text",
                        "content": "是坐标变换，且 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\forall x \\neq 0"
                    },
                    {
                        "type": "text",
                        "content": "必有 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y \\ne \\mathbf{0}"
                    },
                    {
                        "type": "text",
                        "content": ",那么 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\forall x \\neq 0"
                    }
                ]
            },
            "bbox": [
                176,
                546,
                719,
                589
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "x^{\\mathrm{T}} A^{*} x = \\left( A y \\right)^{\\mathrm{T}} A^{*} \\left( A y \\right) = y^{\\mathrm{T}} \\left( \\left| A \\right| A \\right) y = \\left| A \\right| y^{\\mathrm{T}} A y,",
                "math_type": "latex",
                "image_source": {
                    "path": "images/f4ec5770298c6b7ffce474c09ab389e52535206b1a08e87027a50199c5769e48.jpg"
                }
            },
            "bbox": [
                200,
                599,
                690,
                621
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "因A正定， "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\left| \\boldsymbol{A} \\right| > 0, \\boldsymbol{y}^{\\mathrm{T}} \\boldsymbol{A} \\boldsymbol{y} > 0"
                    },
                    {
                        "type": "text",
                        "content": ",从而 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\forall x \\ne 0, x^{\\mathrm{T}} A^{*} x = | A | y^{\\mathrm{T}} A y >"
                    },
                    {
                        "type": "text",
                        "content": "0,故 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "A^{\\bullet}"
                    },
                    {
                        "type": "text",
                        "content": "正定."
                    }
                ]
            },
            "bbox": [
                173,
                627,
                717,
                671
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "方法二 用特征值.设 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "A^{*} \\boldsymbol{\\alpha} = \\lambda \\boldsymbol{\\alpha} , \\boldsymbol{\\alpha} \\neq \\mathbf{0}"
                    },
                    {
                        "type": "text",
                        "content": ",于是"
                    }
                ]
            },
            "bbox": [
                211,
                678,
                591,
                696
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\boldsymbol{A}\\boldsymbol{A}^{*} \\boldsymbol{\\alpha} = \\lambda \\boldsymbol{A}\\boldsymbol{\\alpha} ,  即  \\lambda \\boldsymbol{A}\\boldsymbol{\\alpha} = \\left| \\boldsymbol{A} \\right|\\boldsymbol{\\alpha}.",
                "math_type": "latex",
                "image_source": {
                    "path": "images/8a7de3adfbfca185d68d8b3635b666e5e589a6171957cb3cf11d580eaafc5164.jpg"
                }
            },
            "bbox": [
                314,
                703,
                573,
                720
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "由A可逆知 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "A^{*}"
                    },
                    {
                        "type": "text",
                        "content": "必可逆，那么 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "A^{*}"
                    },
                    {
                        "type": "text",
                        "content": "的特征值 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\lambda \\ne 0"
                    }
                ]
            },
            "bbox": [
                213,
                728,
                608,
                745
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "从而有 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "A\\boldsymbol{\\alpha} = \\frac{\\left |  A\\right | }{\\lambda }\\boldsymbol{\\alpha}"
                    },
                    {
                        "type": "text",
                        "content": ",即 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{\\left| \\begin{array}{c}  A  \\end{array} \\right|}{\\lambda}"
                    },
                    {
                        "type": "text",
                        "content": "是A的特征值."
                    }
                ]
            },
            "bbox": [
                213,
                752,
                571,
                785
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "因A正定，得 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{1}{\\lambda} \\left| \\boldsymbol{A} \\right| > 0"
                    },
                    {
                        "type": "text",
                        "content": ",而 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "|A|>0"
                    },
                    {
                        "type": "text",
                        "content": ",故必有 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\lambda > 0"
                    },
                    {
                        "type": "text",
                        "content": ",故 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "A^{*}"
                    },
                    {
                        "type": "text",
                        "content": "正定."
                    }
                ]
            },
            "bbox": [
